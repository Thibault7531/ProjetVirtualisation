[Unit]
Description=gunicorn daemon
After=network.target

[Service]
User=thibi
Group=www-data
WorkingDirectory=/path/to/repo/metier
EnvironmentFile=/path/to/venv/.env
ExecStart=/path/to/venv/bin/gunicorn \
        --access-logfile - \
        --workers 3 \
        --bind 0.0.0.0:8000 \
        Starvice.wsgi:application

[Install]
WantedBy=multi-user.target
